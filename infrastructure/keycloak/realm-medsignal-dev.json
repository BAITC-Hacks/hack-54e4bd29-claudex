{
  "realm": "medsignal",
  "displayName": "MedSignal (локальная разработка)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "failureFactor": 10,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Системный администратор: пользователи, роли, импорты, конфигурация"
      },
      {
        "name": "HEALTH_AUTHORITY",
        "description": "Сотрудник регионального управления здравоохранения"
      },
      {
        "name": "REGIONAL_ANALYST",
        "description": "Региональный аналитик"
      },
      {
        "name": "HOSPITAL_MANAGER",
        "description": "Руководитель медицинской организации"
      },
      {
        "name": "HOSPITAL_ANALYST",
        "description": "Аналитик медицинской организации"
      }
    ]
  },

  "clients": [
    {
      "clientId": "medsignal-frontend",
      "name": "MedSignal Frontend",
      "description": "Публичный клиент браузера. Код авторизации с PKCE, без секрета.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost/*", "http://localhost:3000/*"],
      "webOrigins": ["http://localhost", "http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost/*"
      },
      "protocolMappers": [
        {
          "name": "medsignal-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "medsignal-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },

    {
      "clientId": "medsignal-api",
      "name": "MedSignal API",
      "description": "Получатель токена. Собственных потоков входа не имеет.",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },

    {
      "clientId": "medsignal-dev-cli",
      "name": "MedSignal Dev CLI (только локальная разработка)",
      "description": "Служебный клиент для автоматической проверки фундамента. В общих средах не создаётся.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "medsignal-dev-cli-local_dev_only",
      "protocolMappers": [
        {
          "name": "medsignal-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "medsignal-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "username": "service-account-medsignal-dev-cli",
      "enabled": true,
      "serviceAccountClientId": "medsignal-dev-cli",
      "realmRoles": ["ADMIN"]
    },
    {
      "id": "e4b2e840-7e8c-4bf0-a15d-85f956c86001",
      "username": "admin",
      "enabled": true,
      "email": "admin@medsignal.local",
      "firstName": "Администратор",
      "lastName": "Системы",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN"]
    },
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "health-authority",
      "enabled": true,
      "email": "health-authority@medsignal.local",
      "emailVerified": false,
      "firstName": "Health",
      "lastName": "Authority",
      "credentials": [
        {
          "type": "password",
          "value": "health-authority-local_dev_only",
          "temporary": false
        }
      ],
      "realmRoles": ["HEALTH_AUTHORITY"]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "regional-analyst",
      "enabled": true,
      "email": "regional-analyst@medsignal.local",
      "emailVerified": false,
      "firstName": "Regional",
      "lastName": "Analyst",
      "credentials": [
        {
          "type": "password",
          "value": "regional-analyst-local_dev_only",
          "temporary": false
        }
      ],
      "realmRoles": ["REGIONAL_ANALYST"]
    },
    {
      "id": "33333333-3333-4333-8333-333333333333",
      "username": "hospital-manager",
      "enabled": true,
      "email": "hospital-manager@medsignal.local",
      "emailVerified": false,
      "firstName": "Hospital",
      "lastName": "Manager",
      "credentials": [
        {
          "type": "password",
          "value": "hospital-manager-local_dev_only",
          "temporary": false
        }
      ],
      "realmRoles": ["HOSPITAL_MANAGER"]
    }
  ]
}
