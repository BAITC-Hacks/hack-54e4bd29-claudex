# ===========================================================================
# MedSignal — конфигурация окружения
# ---------------------------------------------------------------------------
#   cp .env.example .env && docker compose up -d
#
# Значения ниже рассчитаны на локальную разработку и работают сразу.
# Каждый секрет помечен маркером `local_dev_only`. Backend отказывается
# стартовать с таким значением при любом APP_ENV, кроме `local`, поэтому
# эти значения невозможно случайно унести в общую среду.
#
# .env никогда не коммитится. В эксплуатации секреты приходят из внешнего
# хранилища, а не из файла на диске (SECURITY.md, раздел 7).
# ===========================================================================

# --- Приложение ------------------------------------------------------------
APP_ENV=local                      # local | dev | staging | production
APP_DEBUG=true                     # обязан быть false вне local
APP_SECRET=app-secret-local_dev_only
API_PREFIX=/api/v1
LOG_LEVEL=INFO                     # DEBUG запрещён вне local
LOG_FORMAT=json                    # json | console

# --- Сеть и периметр -------------------------------------------------------
HTTP_PORT=80                       # единственный порт, публикуемый наружу
CORS_ALLOWED_ORIGINS=http://localhost
TRUSTED_HOSTS=
FORCE_HTTPS=false                  # true за TLS-терминацией в эксплуатации

# --- PostgreSQL (операционная БД) ------------------------------------------
POSTGRES_DB=medsignal
POSTGRES_USER=medsignal
POSTGRES_PASSWORD=postgres-local_dev_only
POSTGRES_SSLMODE=prefer            # require в эксплуатации

# --- ClickHouse (аналитическая БД) -----------------------------------------
CLICKHOUSE_DB=medsignal_analytics
CLICKHOUSE_USER=medsignal
CLICKHOUSE_PASSWORD=clickhouse-local_dev_only

# --- Redis (кэш, брокер Celery, счётчики частоты) --------------------------
# Три назначения разнесены по логическим базам: вытеснение допустимо
# для кэша и недопустимо для очереди задач (ADR-0003).
REDIS_PASSWORD=redis-local_dev_only

# --- Celery ----------------------------------------------------------------
CELERY_WORKER_CONCURRENCY=2

# --- MinIO (объектное хранилище) -------------------------------------------
MINIO_ROOT_USER=minio-access-local_dev_only
MINIO_ROOT_PASSWORD=minio-secret-local_dev_only

# --- Keycloak --------------------------------------------------------------
# MedSignal не хранит пароли пользователей. Аутентификацию выполняет
# Keycloak по OIDC (ADR-0009).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=keycloak-admin-local_dev_only
KEYCLOAK_PUBLIC_URL=http://localhost/auth

# Публичный издатель сверяется с claim `iss` токена.
OIDC_ISSUER=http://localhost/auth/realms/medsignal
# Внутренний адрес используется для загрузки ключей подписи.
# Смешение этих двух адресов ломает проверку токена.
OIDC_INTERNAL_BASE_URL=http://keycloak:8080/auth/realms/medsignal
OIDC_AUDIENCE=medsignal-api
OIDC_CLIENT_ID=medsignal-frontend

# Подставной адаптер аутентификации. Только для автоматических тестов.
# При любом APP_ENV, кроме local, включение приводит к отказу старта.
AUTH_TEST_MODE=false

# --- MLflow ----------------------------------------------------------------
MLFLOW_DB_NAME=mlflow

# --- Frontend (публичные переменные, попадают в браузер) -------------------
# Секретов здесь быть не может: всё с префиксом NEXT_PUBLIC_ встраивается
# в клиентский код.
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_DISCLAIMER_ENABLED=true

# ===========================================================================
# Порты диагностики
# ---------------------------------------------------------------------------
# Применяются только наложением docker-compose.dev-ports.yml и слушают
# исключительно 127.0.0.1. В базовой конфигурации хранилища портов
# на хост не имеют.
# ===========================================================================
DEV_BACKEND_PORT=8000
DEV_POSTGRES_PORT=5432
DEV_CLICKHOUSE_HTTP_PORT=8123
DEV_CLICKHOUSE_NATIVE_PORT=9000
DEV_MINIO_API_PORT=9002
DEV_MINIO_CONSOLE_PORT=9001
DEV_MLFLOW_PORT=5000

# ===========================================================================
# Появляется в следующих этапах
# ---------------------------------------------------------------------------
# Перечислено для полноты картины. Значения не используются в PHASE 1
# и будут введены вместе с соответствующей функциональностью.
# ===========================================================================

# PHASE 3 — приём данных и псевдонимизация
# PSEUDONYM_SALT=            # компрометация делает возможным обратное
#                            # сопоставление; ротация разрывает связь выгрузок
# PII_STRICT_MODE=true       # прерывать импорт при прямых идентификаторах

# PHASE 5 — прогнозирование
# FORECAST_TARGET=           # не выбирается до Data Audit (ADR-0007)
# FORECAST_HORIZON_DAYS=14
# FORECAST_MIN_HISTORY_DAYS=180

# PHASE 6 — Signal Engine
# SIGNAL_DATA_STALE_HOURS=48
# SIGNAL_ENGINE_ENABLED=true

# PHASE 8 — ограничение частоты запросов
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTHENTICATED_PER_MIN=300

# --- Конвейер загрузки данных (PHASE 3B) ------------------------------------
# Каталог с выгрузками на хосте. Монтируется в контейнер только на чтение.
# Путь нигде не зашит в код: аудит и загрузка запускаются на любом каталоге.
DATA_SOURCE_DIR_HOST=./data/incoming
# Размер пакета обработки. Определяет расход памяти: файл целиком в память
# не читается никогда.
DATA_BATCH_SIZE=50000
# Секрет псевдонимизации идентификаторов. Обычный SHA-256 от кода случая
# подбирается перебором за минуты, поэтому применяется HMAC с этим ключом.
# В эксплуатации значение обязано отличаться и быть не короче 32 символов;
# приложение откажется стартовать с этим примером.
DATA_PSEUDONYMIZATION_KEY=local_dev_only_pseudonymization_key_change_me
